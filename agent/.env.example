STRANDS_PROVIDER=auto

# Bedrock — used automatically once these resolve (aws configure / aws configure sso).
AWS_PROFILE=
AWS_REGION=us-east-1
STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Local OpenAI-compatible fallback, used when Bedrock isn't configured.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_ID=
LOCAL_MODEL_API_KEY=

# Cognee cloud — from https://platform.cognee.ai/api-keys (tenant-specific URL, not the shared host).
COGNEE_API_URL=
COGNEE_API_KEY=
COGNEE_DATASET=freebie-monitor

# Bright Data — used by check_company_standing. Zone name comes from your Bright Data
# dashboard, not a generic default (e.g. "web_unlocker1" often doesn't exist on the account).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
