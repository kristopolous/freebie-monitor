# Model provider for the Strands agents.
# Default: a local/self-hosted OpenAI-compatible endpoint (e.g. Ollama).
LOCAL_MODEL_BASE_URL=https://9ol.es/11434
LOCAL_MODEL_ID=qwen3.8
LOCAL_MODEL_API_KEY=

# ...or unset LOCAL_MODEL_BASE_URL and set ONE of these instead:
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cognee — persistent personal-brain graph. Both values come from your
# tenant's "Connection Details" panel at https://platform.cognee.ai/api-keys
# — COGNEE_API_URL is tenant-specific (https://tenant-<your-tenant-id>.aws.cognee.ai),
# not the shared api.cognee.ai host. Auth is the X-Api-Key header only.
COGNEE_API_KEY=
COGNEE_API_URL=

# Bright Data — live deal/offer discovery.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Real but slow (~30-45s: 3 real unlocks + an LLM parse of noisy SERP HTML).
# Off by default so /api/deals stays fast on seed data; opt in explicitly.
SCOUT_LIVE_EXTRACTION=false

PORT=3000
